{
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weareredlight/redlight-ds.git"
  },
  "keywords": [
    "redlight",
    "design",
    "system",
    "library",
    "ui",
    "components",
    "react",
    "scss",
    "css-modules",
    "typescript"
  ],
  "author": "redlightsoft",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/weareredlight/redlight-ds/issues"
  },
  "name": "@weareredlight/design-system",
  "description": "RedLight's Design System is a comprehensive collection of design and development resources that aims to streamline and enhance the creation of consistent, user-centric digital experiences.",
  "homepage": "http://weareredlight.github.io/redlight-ds",
  "version": "0.2.4",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "resolutions": {
    "nth-check": "^2.0.1",
    "semver": "^7.5.4",
    "@babel/traverse": "^7.23.2",
    "glob-parent": "^5.1.2",
    "trim-newlines": "^3.0.1",
    "trim": "^0.0.3",
    "postcss": "^8.4.31",
    "@adobe/css-tools": "^4.3.1"
  },
  "scripts": {
    "start": "vite playground --config vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "ts": "tsc",
    "ts-watch": "tsc --watch",
    "lint": "npx eslint src --max-warnings 0",
    "lint-fix": "npx eslint src --max-warnings 0 --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "nip": "knip --no-progress",
    "nip:fix": "knip --fix",
    "validate": "tsc --noEmit && tsc -p playground && tsc -p src/stories && tsc -p .storybook && tsc -p tsconfig.node.json && yarn lint && yarn nip",
    "predeploy-storybook": "yarn build-storybook",
    "deploy-storybook": "gh-pages -d storybook-static",
    "build-storybook": "storybook build",
    "build": "rm -rf dist && yarn build:js && yarn build:types",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly && tsc-alias -p tsconfig.build.json",
    "prepare": "yarn build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.13.0",
    "dayjs": "^1.11.23",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.57.0",
    "react-clock": "^6.0.0",
    "react-date-picker": "^12.1.0",
    "react-number-format": "^5.3.1",
    "react-select": "^5.8.0",
    "react-time-picker": "^8.1.0",
    "react-toastify": "^10.0.4"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/lodash.merge": "^4.6.7",
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.11.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "6.42.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sass-embedded": "^1.105.1",
    "shiki": "^4.5.0",
    "storybook": "10.6.2",
    "tsc-alias": "1.9.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
