// Editor type-checking for the stories, which the root tsconfig.json excludes from the library build
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    // Storybook 10 packages are ESM-only and only resolvable through package.json "exports"
    "moduleResolution": "bundler"
  },
  "include": [
    ".",
    "../declaration.d.ts"
  ],
  "exclude": []
}